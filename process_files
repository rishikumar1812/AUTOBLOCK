import os
import pandas as pd
import time
import logging
from datetime import datetime,date
from register_logger import register_stop_event
from stop_tracker import get_all_stop_times
from config_loader import get_config
from log_cleanup import cleanup_old_logs, DailyFileHandler,cleanup_days

# configuration -> loaded from config.json, not hardcoded

def _cfg():
    # print(get_config)
    return get_config()

def LOG_DIRECTORY() -> str:
    print(_cfg()["paths"]["log_dir"])
    return _cfg()["paths"]["log_dir"]

def LOG_REG_DIR() -> str:
    print("log_reg_dir \n",_cfg()["paths"]["LOG_REG_DIR"])
    return _cfg()["paths"]["LOG_REG_DIR"]

def MAX_RECORD() -> int:
    return _cfg()['monitor']["max_record_window"]

def DL_COUNT() -> int:
    return _cfg()["monitor"]["dl_count"]

def BLOCK_AT_FAILS() -> int:
    return _cfg()['thresholds']['block_at_fails']

def POLL_INTERVAL() -> int:
    return _cfg()['monitor']['poll_interval_sec']

def _setup_logger()->logging.Logger:
    log_reg_dir=get_config()["paths"]["LOG_REG_DIR"]
    os.makedirs(log_reg_dir,exist_ok=True)

    # Delete log files older than 7 days — runs once at startup
    cleanup_old_logs(log_reg_dir, retention_days=cleanup_days())

    logger=logging.getLogger("process_files")

    if not logger.handlers:
        logger.setLevel(logging.INFO)

        # DailyFileHandler checks the date on EVERY log call and
        # automatically opens a new file at midnight — this process
        # runs 24/7 via the while-loop below, so a fixed filename
        # string (old version) would never roll over on its own.
        fh = DailyFileHandler("process_files", log_reg_dir, retention_days=cleanup_days())
        logger.addHandler(fh)

        sh=logging.StreamHandler()
        sh.setFormatter(logging.Formatter("%(asctime)s [%(levelname)s] %(message)s"))
        logger.addHandler(sh)
    return logger
logger=_setup_logger()



def is_today(file: str) -> bool :
    mode_time=datetime.fromtimestamp(os.path.getmtime(file))
    return mode_time.date()==date.today()

def read_latest_file(files:str):
    sections = []
    current_section=[]
    row=[]
    current={}

    
    current_section=[]
    with open(files,"r") as f:
        for line in f:
            line=line.strip()
            if line.startswith("#INIT"):
                if current_section:
                    sections.append(current_section)
                    current_section=[]
                current_section.append(line)
            else:
                current_section.append(line)
        
        if current_section:
            sections.append(current_section)
    for section in sections:
        # print(f"Section:{i+1}\n",section)
        # i+=1
        for line in section:
            if line.startswith("RESULT:"):
                current['RESULT']=line.split("RESULT:")[1].strip()
            if line.startswith("TIME :"):
                current['Update_Time']=line.split("TIME :")[1].strip()
            if line.startswith("DATE :"):
                current['DATE']=line.split("DATE :")[1].strip()
            if line.startswith("ARRAY :"):
                current['ARRAY']=line.split("ARRAY :")[1].strip()
            if line.startswith("JIG :"):
                current['JIG']=line.split("JIG :")[1].strip()
                
            if all(k in current for k in ['DATE','Update_Time','JIG','ARRAY','RESULT']):
                row.append(current)
                current={}
    if not row:
        return None
    data=pd.DataFrame(row,columns=['DATE','Update_Time','JIG','ARRAY','RESULT'])
    data['Time_stamp']=pd.to_datetime(data['DATE']+" "+data['Update_Time'],errors='coerce')
    sorted_df = data.sort_values(by='Time_stamp')
    print("data",sorted_df)
    return sorted_df


def process_log():
    directory=LOG_DIRECTORY()
    print("directory\n",directory)
    files=[os.path.join(directory,f) for f in os.listdir(directory) if f.endswith(".csv")]
    print("files\n",files)
    dl_files=[[] for _ in range(DL_COUNT())]
    result_messages=[]
    block_threshold=BLOCK_AT_FAILS()

    logging.info(f"[process_files] Scan stared - dir :{directory} | "
                 f"DLs:{DL_COUNT} | block at:{block_threshold} fails")
    
    # guard: log directory must exist
    if not os.path.isdir(directory):
        logger.error(f"[process_files]  log directory not found :{directory}")
        return result_messages

    # print(csv_files)
    for file in files:
        key=os.path.basename(file)[-7:-5 ]
        if is_today(file):
            index=int(key)-int('01')
            if 0<=index<len(dl_files):
                dl_files[index].append(file)

    # laod the stop_tracker.json once for all dls
    print("before all stop")
    all_stops=get_all_stop_times()
    print("after all stop",all_stops)
    for i, files in enumerate(dl_files):
        dl_name=f"DL{i+1:02d}"
        if not files:
            logger.debug(f"[process_files] {dl_name} - no file today, skipping")
            continue
        # print(f'DL_{i+1}\n')
        combined_df=pd.DataFrame()
        for  file in files:
            data=read_latest_file(file)
            if data is not None:
                combined_df=pd.concat([combined_df,data],ignore_index=True)
            
        if combined_df.empty:
            logger.warning(f"[process_files] {dl_name} - files found but no valied records")
            continue
        combined_df=combined_df.sort_values(by='Time_stamp').reset_index(drop=True)
        
        print(f"{dl_name} \n: {combined_df}")

        last_stop_str=all_stops.get(dl_name,{}).get("last_stop")
        print('last_stop_str',last_stop_str)
        if last_stop_str:
            try:
                last_stop_ts=datetime.fromisoformat(last_stop_str)
                active_df=combined_df[combined_df["Time_stamp"] > pd.Timestamp(last_stop_ts) ]
            except Exception as e:
                logger.error(f"[process_files]{dl_name} - bad last_stop value : {e}")
        else:
            active_df=combined_df
        if len(active_df)>MAX_RECORD():
            active_df=active_df.tail(MAX_RECORD()).reset_index(drop=True)
        if active_df.empty:
            logger.info(f"[process_files]{dl_name} - no new record since last stop")
            continue
       
        fail_df=active_df[active_df['RESULT']=='FAIL']
        fail_count=len(fail_df)
        fail_rate=(fail_count/len(active_df))*100
        # print(f"{dl_name} : {fail_df}")

        if fail_count >= BLOCK_AT_FAILS():
            latest_fail=fail_df.iloc[-1]
            print("latest_fail",latest_fail)
            registered=register_stop_event(dl_name,latest_fail)
            # print("registered",registered)
            if registered:
                msg=(
                    f'{dl_name} STOPPED | '
                    f'Cycle Fails = {fail_count} |'
                    f'Fail Rate = {fail_rate:.2f}% |' 
                )
                logger.warning(f"[process_files] {msg}")
                result_messages.append(msg)
            elif registered is None:
                logger.error(
                    f"{dl_name} WARNING: register_stop_event returned None"
                    f"(check register_logger.py).Fail_count={fail_count}"
                )
    logger.info(
        f"[process_files] Scan Complete- "
        f"{len(result_messages)} stops triggered this tick"
    )

    return result_messages

if __name__ == '__main__':
    # ── Hide console and enforce single instance ──────────
    try:
        import ctypes, sys as _sys
        hwnd = ctypes.windll.kernel32.GetConsoleWindow()
        if hwnd:
            ctypes.windll.user32.ShowWindow(hwnd, 0)
    except Exception:
        pass

    try:
        from tray_utils import SingleInstance
        _si = SingleInstance("DLProcessFile")
        if not _si.acquire():
            logger.error(
                "[process_files] Another instance already running. Exiting.")
            import sys; sys.exit(1)
    except Exception as _e:
        logger.warning(f"[process_files] SingleInstance check failed: {_e}")
        _si = None

    interval=POLL_INTERVAL()
    logger.info(f"[process_files] DL Monitor started. "
                f"Scanning every {interval}s. Press Ctrl+C to stop.")
    try:
        while True:
            try:
                messages=process_log()
            except Exception as e:
                logger.error(f'[process_files] Unhandled error during scan : {e}')
            time.sleep(POLL_INTERVAL())
    finally:
        if _si:
            _si.release()