{
    "_comment": "FT PC config — set ft_id once and never change it. F1-F4=Front Rack Function 1-4, R1-R4=Rear Rack Function 1-4",
    "ft": {
        "ft_id": "F1"
    },
    "network": {
        "main_pc_ip": "192.168.0.21",
        "main_pc_port": 8998,
        "timeout_sec": 10
    },
    "paths": {
        "log_dir": "C:\\FT\\logs",
        "log_reg_dir": "C:\\FT\\log_register"
    },
    "monitor": {
        "poll_interval_sec": 30,
        "record_window": 60
    },
    "thresholds": {
        "warn_at_fail": 2,
        "block_at_fails": 4
    },
    "dashboard": {
        "refresh_interval_ms": 10000,
        "heartbeat_sec": 1800
    }
}
