# =========================================================
# DL Existence Registry
# Persists which DL indices (0-based) have EVER had a CSV.
# Survives 7-day log cleanup — once seen, always remembered.
# File: LOG_REG_DIR/dl_existence_registry.json
# =========================================================
def _registry_path() -> str:
    return os.path.join(LOG_REGISTER_DIR(), "dl_existence_registry.json")


def _load_registry() -> set:
    """Return set of DL indices that have ever had a CSV file."""
    try:
        if os.path.exists(_registry_path()):
            with open(_registry_path(), "r", encoding="utf-8") as f:
                return set(json.load(f).get("exists", []))
    except Exception:
        pass
    return set()


def _save_registry(registry: set) -> None:
    """Persist registry — only called when new DLs discovered."""
    try:
        os.makedirs(os.path.dirname(_registry_path()), exist_ok=True)
        with open(_registry_path(), "w", encoding="utf-8") as f:
            json.dump({"exists": sorted(registry)}, f)
    except Exception as e:
        print(f"[registry] Failed to save: {e}")


# =========================================================
# Compute DL stats
# =========================================================
def compute_dl_stats() -> list:
    directory=LOG_DIRECTORY()
    now=datetime.now()
    print("now",type(now))
    stats=[]
    files=[os.path.join(directory,f) for f in os.listdir(directory) if f.endswith(".csv")]
    dl_files=[[] for _ in range(DL_COUNT())]
    block_threshold=BLOCK_AT_FAILS()
    print("initalization done")
    # guard: log directory must exist
    if not os.path.isdir(directory):
        for i in range(DL_COUNT()):
            stats.append({
                "name": f"DL{i+1:02d}", "total": 0, "fails": 0,
                "rate": 0.0, "status": "NO DIR",
                "stops_today": 0, "last_stop": "—",
            })
        return stats
    print("stats",stats)
    # print(csv_files)
    # ── Existence registry — persistent across 7-day log cleanup ──
    registry   = _load_registry()
    newly_seen = set()
    for file in files:
        key = os.path.basename(file)[-7:-5]
        try:
            index = int(key) - 1
            if 0 <= index < DL_COUNT():
                newly_seen.add(index)
            if is_today(file):
                if 0 <= index < len(dl_files):
                    dl_files[index].append(file)
        except ValueError:
            continue

    # Persist any newly discovered DLs
    if newly_seen - registry:
        registry = registry | newly_seen
        _save_registry(registry)
    else:
        registry = registry | newly_seen

    print('all_stop_time')
    all_stops = get_all_stop_times()
    print("all_stop",all_stops)

    for i, files in enumerate(dl_files):
        dl_name     = f"DL{i+1:02d}"
        stops_today = get_stop_count_today(dl_name)
        stop_entry  = all_stops.get(dl_name, {})
        raw_stop    = stop_entry.get("last_stop")
        last_stop_ts = None
        if raw_stop:
            try:
                last_stop_ts = datetime.fromisoformat(raw_stop)
                print("last_stop",last_stop_ts)
            except Exception:
                pass

        if not files:
            # DL does not exist if never seen in registry AND no stop record
            dl_exists = (i in registry) or (stop_entry != {})
            if not dl_exists:
                stats.append(_empty_stat(dl_name, "NOT EXIST",
                                         stops_today, _last_stop_str(last_stop_ts)))
            else:
                # A DL with no CSV file today may simply be genuinely
                # idle (STOPPED), or it may still be BLOCKED from an
                # earlier stop that hasn't been cleared by a new PASS
                # yet. No data does not by itself mean STOPPED.
                idle_status, idle_bmin = _idle_status(last_stop_ts, now)
                stats.append(_empty_stat(
                    dl_name, idle_status, stops_today,
                    _last_stop_str(last_stop_ts),
                    blocked_since_min=idle_bmin,
                    blocked_since=(_last_stop_str(last_stop_ts)
                                  if idle_status == "BLOCKED" else "—"),
                ))
            continue

        combined = pd.DataFrame()
        for fpath in files:
            df = read_latest_file(fpath)
            if df is not None:
                combined = pd.concat([combined, df], ignore_index=True)

        if combined.empty:
            idle_status, idle_bmin = _idle_status(last_stop_ts, now)
            stats.append(_empty_stat(
                dl_name, idle_status, stops_today,
                _last_stop_str(last_stop_ts),
                blocked_since_min=idle_bmin,
                blocked_since=(_last_stop_str(last_stop_ts)
                              if idle_status == "BLOCKED" else "—"),
            ))
            continue

        combined  = combined.sort_values("Time_stamp").reset_index(drop=True)
        latest_ts = combined["Time_stamp"].max()
        print("latest_ts\n",type(latest_ts.to_pydatetime()))
        print("now",type(now))
        minutes_since = (now - latest_ts.to_pydatetime()).total_seconds() / 60
        print("minutes_since",minutes_since)

        if minutes_since >= NO_DATA_MINUTES():
            # A previous STOP does not permanently mean BLOCKED. If a
            # PASS record already arrived after last_stop_ts, the DL
            # has recovered — going idle afterward reports STOPPED,
            # not BLOCKED.
            recovered = _recovered_after_stop(combined, last_stop_ts)
            idle_status, idle_bmin = _idle_status(last_stop_ts, now, recovered)
            last60_s   = combined.tail(60)
            fails_60_s = int(last60_s[last60_s["RESULT"].str.upper() == "FAIL"].shape[0])
            rate_60_s  = (fails_60_s / len(last60_s) * 100) if len(last60_s) > 0 else 0.0
            stats.append({
                "name": dl_name, "total": len(combined),
                "fails": 0, "rate": 0.0, "status": idle_status,
                "stops_today": stops_today,
                "last_stop": _last_stop_str(last_stop_ts),
                "last_data": latest_ts.strftime("%H:%M:%S"),
                "minutes_since": int(minutes_since),
                "fails_60": fails_60_s, "rate_60": rate_60_s,
                "blocked_since_min": idle_bmin,
                "blocked_since": (_last_stop_str(last_stop_ts)
                                 if idle_status == "BLOCKED" else "—"),
            })
            continue

        if last_stop_ts is not None:
            active = combined[combined["Time_stamp"] > pd.Timestamp(last_stop_ts)]
        else:
            active = combined

        if len(active) > MAX_RECORDS():
            active = active.tail(MAX_RECORDS()).reset_index(drop=True)

        total = len(active)
        if total == 0:
            last60_z   = combined.tail(60)
            fails_60_z = int(last60_z[last60_z["RESULT"].str.upper() == "FAIL"].shape[0])
            rate_60_z  = (fails_60_z / len(last60_z) * 100) if len(last60_z) > 0 else 0.0
            bmin_z     = 0
            z_status   = "BLOCKED" if last_stop_ts else "RUNNING"
            if z_status == "BLOCKED" and last_stop_ts:
                bmin_z = int((now - last_stop_ts).total_seconds() / 60)
            stats.append({
                "name": dl_name, "total": 0,
                "fails": 0, "rate": 0.0,
                "status": z_status,
                "stops_today": stops_today,
                "last_stop": _last_stop_str(last_stop_ts),
                "last_data": latest_ts.strftime("%H:%M:%S"),
                "minutes_since": int(minutes_since),
                "fails_60": fails_60_z, "rate_60": rate_60_z,
                "blocked_since_min": bmin_z,
                "blocked_since": (_last_stop_str(last_stop_ts)
                                 if z_status == "BLOCKED" else "—"),
            })
            continue

        fails      = int(active[active["RESULT"].str.upper() == "FAIL"].shape[0])
        pass_count = int(active[active["RESULT"].str.upper() == "PASS"].shape[0])
        rate       = (fails / total * 100) if total > 0 else 0.0

        if last_stop_ts is not None and pass_count == 0:
            status = "BLOCKED"
        elif fails >= BLOCK_AT_FAILS():
            status = "BLOCKED"
        elif fails >= WARN_AT_FAILS():
            status = "WARNING"
        else:
            status = "RUNNING"

        # Last-60 stats from full combined data
        last60   = combined.tail(60)
        fails_60 = int(last60[last60["RESULT"].str.upper() == "FAIL"].shape[0])
        rate_60  = (fails_60 / len(last60) * 100) if len(last60) > 0 else 0.0

        # How long has this DL been blocked
        blocked_since_min = 0
        if status == "BLOCKED" and last_stop_ts is not None:
            blocked_since_min = int(
                (now - last_stop_ts).total_seconds() / 60)

        stats.append({
            "name": dl_name, "total": total,
            "fails": fails, "rate": rate, "status": status,
            "stops_today": stops_today,
            "last_stop": _last_stop_str(last_stop_ts),
            "last_data": latest_ts.strftime("%H:%M:%S"),
            "minutes_since": int(minutes_since),
            "fails_60": fails_60,
            "rate_60": rate_60,
            "blocked_since_min": blocked_since_min,
            "blocked_since": (_last_stop_str(last_stop_ts)
                             if status == "BLOCKED" else "—"),
        })

    return stats


def _idle_status(last_stop_ts, now: datetime, recovered: bool = False) -> tuple:
    """
    Decide status/blocked_since_min whenever there's no fresh data to
    evaluate for a DL (missing files, empty parse, or the no-data
    timeout).

    last_stop_ts is HISTORICAL — it must not by itself keep a DL
    BLOCKED forever. If a PASS record already arrived after
    last_stop_ts (recovered=True), the block is considered cleared,
    and subsequent idle time reports STOPPED like any other idle DL.
    Only an un-recovered block (no PASS after the STOP) stays BLOCKED
    indefinitely while idle.
    """
    if last_stop_ts is not None and not recovered:
        blocked_min = int((now - last_stop_ts).total_seconds() / 60)
        return "BLOCKED", blocked_min
    return "STOPPED", 0


def _recovered_after_stop(combined_df, last_stop_ts) -> bool:
    """True if at least one PASS record exists strictly after
    last_stop_ts. Determines whether a prior STOP has been cleared,
    per the recovery lifecycle: BLOCKED -> (PASS) -> RUNNING ->
    (no data) -> STOPPED."""
    if last_stop_ts is None:
        return False
    after_stop = combined_df[
        combined_df["Time_stamp"] > pd.Timestamp(last_stop_ts)
    ]
    if after_stop.empty:
        return False
    return bool((after_stop["RESULT"].str.upper() == "PASS").any())


def _empty_stat(dl_name, status="STOPPED", stops_today=0, last_stop="—",
                blocked_since_min=0, blocked_since="—"):
    return {
        "name": dl_name, "total": 0, "fails": 0,
        "rate": 0.0, "status": status,
        "stops_today": stops_today, "last_stop": last_stop,
        "last_data": "—", "minutes_since": 0,
        "fails_60": 0, "rate_60": 0.0,
        "blocked_since_min": blocked_since_min,
        "blocked_since": blocked_since,
    }


