Step 6: Create Indexes

These are important because eventually we'll have a lot of historical data.

CREATE INDEX IX_lines_connection_status
ON dbo.lines(connection_status);
GO

CREATE INDEX IX_lines_last_seen
ON dbo.lines(last_seen_at);
GO

CREATE INDEX IX_line_units_line
ON dbo.line_units(line_id);
GO

CREATE INDEX IX_line_units_type
ON dbo.line_units(line_id, unit_type);
GO

CREATE INDEX IX_monitoring_events_line_time
ON dbo.monitoring_events(line_id, event_time);
GO

CREATE INDEX IX_monitoring_events_line_shift_time
ON dbo.monitoring_events(line_id, shift_code, event_time);
GO

CREATE INDEX IX_monitoring_events_unit_time
ON dbo.monitoring_events(unit_id, event_time);
GO

